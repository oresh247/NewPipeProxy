<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:padding="@dimen/video_item_search_padding">

    <FrameLayout
        android:id="@+id/itemThumbnailContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="3dp"
        android:layout_marginRight="15dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:ignore="RtlHardcoded">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemThumbnailView"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/placeholder_person"
            app:shapeAppearance="@style/CircularImageView" />

        <View
            android:id="@+id/itemNewContentIndicator"
            android:layout_width="@dimen/subscription_new_content_dot_size"
            android:layout_height="@dimen/subscription_new_content_dot_size"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/subscription_new_content_dot"
            android:elevation="4dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/itemTitleView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:layout_toRightOf="@+id/itemThumbnailContainer"
        android:ellipsize="end"
        android:lines="1"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="@dimen/video_item_search_title_text_size"
        tools:ignore="RtlHardcoded"
        tools:text="Channel Title, Lorem ipsum" />

    <TextView
        android:id="@+id/itemAdditionalDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/itemTitleView"
        android:layout_toRightOf="@+id/itemThumbnailContainer"
        android:lines="1"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="@dimen/video_item_search_upload_date_text_size"
        tools:ignore="RtlHardcoded"
        tools:text="10M subscribers" />

</RelativeLayout>
